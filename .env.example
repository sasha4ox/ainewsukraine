# PostgreSQL (Railway)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o

# Telegram Client API / MTProto (reading channels)
# Create an app at https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated locally by: npm run tg:login
TELEGRAM_SESSION=

# Telegram Bot API (publishing our digest)
TELEGRAM_BOT_TOKEN=
# Channel username (@chomu_ne_ukrainskoyu) or numeric id (-100...)
TELEGRAM_CHANNEL_ID=

# Digest rules
TIMEZONE=Europe/Kyiv
DIGEST_TIME=19:00
DIGEST_NEWS_COUNT=10
MIN_CREDIBILITY_SCORE=70
MIN_IMPORTANCE_SCORE=0
MAX_PER_CATEGORY=3
MAX_EVENTS_TO_SCORE=25
MAX_AI_GROUPS=15
COPY_SIMILARITY_THRESHOLD=0.65
CLUSTER_SIMILARITY_THRESHOLD=0.28
CLUSTER_TIME_WINDOW_HOURS=18

# Optional: scrape t.me/s/<username> if MTProto session is missing/revoked
TELEGRAM_WEB_FALLBACK=false

# Logging
LOG_LEVEL=info
