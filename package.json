{
  "name": "chomu-ne-ukrainskoyu",
  "version": "0.1.0",
  "private": true,
  "description": "Chomu ne Ukrainskoyu - AI-powered Ukrainian daily news editor",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "collect": "tsx src/scripts/collect.ts",
    "digest": "tsx src/scripts/daily-digest.ts",
    "tg:login": "tsx src/scripts/tg-login.ts",
    "tg:join": "tsx src/scripts/tg-join.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/normalize/text.test.ts src/pipeline/credibility.test.ts src/pipeline/selection.test.ts src/pipeline/cluster.test.ts src/pipeline/quality.test.ts src/publish/telegram-bot.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "dotenv": "^16.6.1",
    "luxon": "^3.7.1",
    "openai": "^4.104.0",
    "pino": "^9.9.0",
    "rss-parser": "^3.13.0",
    "telegram": "^2.26.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.17.2",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
